# Example Nginx server block for TurkDemy.
# Adjust certificate paths/upstream details to match the host.

server {
    listen 443 ssl http2;
    server_name turkdemy.com www.turkdemy.com;

    # Agent logos, application attachments, and agent documents are multipart
    # uploads. Nginx defaults client_max_body_size to 1m, which is too small.
    client_max_body_size 25M;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
