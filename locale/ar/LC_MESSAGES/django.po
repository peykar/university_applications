msgid "%(provider)s disconnected."
msgstr "تم فصل %(provider)s."

msgid "Account protection"
msgstr "حماية الحساب"

msgid "Account security"
msgstr "أمان الحساب"

msgid "Add a verified email to use passwordless email-code login."
