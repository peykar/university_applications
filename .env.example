DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Local development may omit DATABASE_URL to use SQLite.
# Docker/production:
DATABASE_URL=postgresql://turkdemy:turkdemy@db:5432/turkdemy
DB_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=1

DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_URL=/media/

SYSTEM_USER_USERNAME=system
SYSTEM_USER_EMAIL=system@turkdemy.local
SYSTEM_USER_IS_ACTIVE=0
SYSTEM_USER_IS_STAFF=0
SYSTEM_USER_IS_SUPERUSER=0
