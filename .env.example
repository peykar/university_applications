DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# Canonical public URL used to build links in email/notifications/background jobs.
SITE_URL=https://turkdemy.com

# Hosts Django accepts.
DJANGO_ALLOWED_HOSTS=turkdemy.com,www.turkdemy.com

# Trusted origins for CSRF-protected browser requests.
DJANGO_CSRF_TRUSTED_ORIGINS=https://turkdemy.com,https://www.turkdemy.com

# Needed when a browser frontend/API consumer is hosted on another origin.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=1

# Email / SMTP
# For local development, keep the console backend and emails will be printed.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TurkDemy <noreply@turkdemy.com>
SERVER_EMAIL=TurkDemy <noreply@turkdemy.com>
SUPPORT_EMAIL=support@turkdemy.com


# Local development may omit DATABASE_URL to use SQLite.
# Docker/production:
DATABASE_URL=postgresql://turkdemy:turkdemy@db:5432/turkdemy
DB_CONN_MAX_AGE=60


DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_URL=/media/

SYSTEM_USER_USERNAME=system
SYSTEM_USER_EMAIL=system@turkdemy.local
SYSTEM_USER_IS_ACTIVE=0
SYSTEM_USER_IS_STAFF=0
SYSTEM_USER_IS_SUPERUSER=0


# Authentication: django-allauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_DATE_VALIDITY=30
